{
  "name": "dnlwlsn",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "sh tools/vendor.sh",
    "fonts": "python3 tools/fetch_fonts.py",
    "cv": "node tools/build-cv.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:py": "python3 -m unittest discover -s tests/py -v",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:perf": "playwright test --project=perf",
    "test": "npm run test:unit && npm run test:py && npm run test:e2e",
    "deploy": "npm test && npm run test:perf && wrangler pages deploy site --project-name dnlwlsn --branch main"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "pdfjs-dist": "6.4.299",
    "wrangler": "4.110.0"
  }
}
